---
export interface Props {
  title: string;
  description: string;
  siteName: string;
  domain: string;
  path: string;
  datePublished?: string;
  dateModified?: string;
  author?: { name: string; type?: 'Person' | 'Organization' };
  type?: 'Article' | 'WebPage';
}
const {
  title,
  description,
  siteName,
  domain,
  path,
  datePublished,
  dateModified,
  type = 'Article',
  author,
} = Astro.props;
const canonical = new URL(path.replace(/\.html$/, ''), `https://www.${domain}`);
canonical.protocol = 'https:';
canonical.host = `www.${domain}`;
canonical.search = '';
canonical.hash = '';
const url = canonical.toString();
const schema = {
  '@context': 'https://schema.org',
  '@type': type,
  headline: title,
  description,
  datePublished,
  dateModified,
  url,
  author: author ? { '@type': author.type ?? 'Person', name: author.name } : undefined,
  publisher: { '@type': 'Organization', name: siteName },
};
---
<script type="application/ld+json" set:html={JSON.stringify(schema).replace(/</g, '\\u003c')} />
