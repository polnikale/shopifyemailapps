---
import BaseLayout from '../../layouts/BaseLayout.astro';
import ArticleSchema from '../../components/ArticleSchema.astro';
import FaqSection from '../../components/FaqSection.astro';
import { site } from '../../content';
const path = '/use-cases';
const title = 'Shopify email use-case guides';
const desc = 'Choose a customer workflow, define its event and stop conditions, and evaluate the evidence needed to release it.';
const jobs = [
  {
    "slug": "welcome-series",
    "name": "Welcome series",
    "job": "Resolve signup source, promised benefit and first-purchase intent."
  },
  {
    "slug": "abandoned-cart",
    "name": "Abandoned cart",
    "job": "Resume a known basket while checking purchases and availability."
  },
  {
    "slug": "browse-abandonment",
    "name": "Browse abandonment",
    "job": "Follow identified product interest without pretending a view is a checkout."
  },
  {
    "slug": "post-purchase",
    "name": "Post-purchase",
    "job": "Match education and service to order, delivery and product use."
  },
  {
    "slug": "replenishment",
    "name": "Replenishment",
    "job": "Estimate a relevant reorder window without duplicating subscriptions."
  },
  {
    "slug": "loyalty",
    "name": "Loyalty",
    "job": "Explain earned benefits, eligibility and redemption."
  },
  {
    "slug": "vip-segments",
    "name": "VIP segments",
    "job": "Define valuable customer groups and deliver the promised treatment."
  },
  {
    "slug": "reviews-and-ugc",
    "name": "Reviews and UGC",
    "job": "Ask at an appropriate product-use stage and manage permission to reuse content."
  },
  {
    "slug": "winback",
    "name": "Winback",
    "job": "Distinguish a lapsed buying pattern from an ordinary long purchase cycle."
  },
  {
    "slug": "product-launch",
    "name": "Product launch",
    "job": "Coordinate access, product readiness and launch communications."
  },
  {
    "slug": "back-in-stock",
    "name": "Back in stock",
    "job": "Notify explicit variant demand against actual sellable inventory."
  },
  {
    "slug": "black-friday",
    "name": "Black Friday",
    "job": "Coordinate sale access, offer terms, contact pressure and stock."
  },
  {
    "slug": "holiday-gifting",
    "name": "Holiday gifting",
    "job": "Separate buyer and recipient needs and communicate verified fulfillment options."
  },
  {
    "slug": "discount-strategy",
    "name": "Discount strategy",
    "job": "Resolve offer eligibility, contribution limits and cross-flow conflicts."
  },
  {
    "slug": "segmentation",
    "name": "Segmentation",
    "job": "Define membership from reliable fields and handle missing data."
  },
  {
    "slug": "email-design",
    "name": "Email design",
    "job": "Make product content, terms and links usable in received messages."
  },
  {
    "slug": "deliverability",
    "name": "Deliverability",
    "job": "Diagnose authentication, delivery outcomes and provider incidents."
  },
  {
    "slug": "analytics",
    "name": "Analytics",
    "job": "Define denominators, attribution and credible comparisons for decisions."
  }
];
const faqs = [
  {
    "question": "Which workflow should I implement first?",
    "answer": "Choose the most consequential observed problem and check its dependencies. Establish measurement and a safe release path alongside that work."
  },
  {
    "question": "Do I need a new app for each workflow?",
    "answer": "No. Demonstrate the required event, branching and stop behavior in the current stack before adding tools. Evaluate a new tool against a concrete gap and its operating cost."
  },
  {
    "question": "Are the exercises observed merchant results?",
    "answer": "No. A proposed fixture or rehearsal is a way to inspect behavior. Record the actual result when you run it; do not turn an expected outcome into a success claim."
  }
];
---
<BaseLayout title={title} description={desc} site={site} path={path}>
  <ArticleSchema title={title} description={desc} siteName={site.name} domain={site.domain} path={path} />
  <section class="container py-16">
    <p class="editorial-kicker">Lifecycle playbooks</p>
    <h1 class="hero-title mt-5 max-w-5xl">{title}</h1>
    <p class="mt-7 max-w-3xl text-xl leading-9">{desc}</p>
    <p class="mt-5 max-w-3xl text-lg leading-8">Use this directory to distinguish a message trigger from the systems it depends on. A gift shipping promise, an inferred product interest and an explicit restock request require different evidence and different stop conditions.</p>
  </section>
  <section class="container pb-12">
    <h2 class="font-serif text-4xl font-black">Choose the job</h2>
    <div class="mt-8 grid gap-5 md:grid-cols-2 lg:grid-cols-3">
      {jobs.map((job) => <a class="card" href={`/use-cases/${job.slug}`}><h3 class="text-xl font-bold">{job.name}</h3><p class="mt-3">{job.job}</p></a>)}
    </div>
  </section>
  <section class="container pb-12"><div class="prose-shopify max-w-4xl">
    <h2>Choose the problem with observable evidence</h2>
    <p>Start with an actual defect or unmet customer need: a care message arrives before delivery, a waitlist promises stock that is unavailable, or a valid code fails at checkout. Record affected orders or profiles, the source event and the owner. Prioritize by customer impact, reach, dependencies and effort. A broken fulfillment promise may deserve attention before a higher-volume promotional flow; there is no universal sequence or two-week minimum.</p>
  </div></section>
  <section class="container pb-12"><div class="prose-shopify max-w-4xl">
    <h2>Separate triggers from supporting systems</h2>
    <p>Welcome, cart, browse and order events can start messages. Segmentation, design, discount policy, delivery monitoring and analytics support several of those messages. Improving a supporting system can fix more than one workflow. Record which active flows depend on a field or template before changing it, and keep item-specific state distinct from broad customer labels.</p>
  </div></section>
  <section class="container pb-12"><div class="prose-shopify max-w-4xl">
    <h2>Write the contract before choosing a tool</h2>
    <p>For the chosen job specify the source of intent, identity, eligible audience, send condition, expiry, re-entry and stop conditions. Define what happens when data arrive late or are missing. State the customer promise and who can pause it. Use a real event fixture and expected output; a feature name on a supplier page does not establish your required behavior.</p>
  </div></section>
  <section class="container pb-12"><div class="prose-shopify max-w-4xl">
    <h2>Map collisions at dispatch</h2>
    <p>List flows that can target the same person or item. Decide whether each pair should continue, defer, replace an offer or cancel. An order may stop recovery for that basket while leaving unrelated service information useful. Recheck conditions when queued messages dispatch, and include delayed events, retries and cross-channel offers in the handoff. Avoid a single permanent suppression label that obscures the reason.</p>
  </div></section>
  <section class="container pb-12"><div class="prose-shopify max-w-4xl">
    <h2>Keep measurement alongside implementation</h2>
    <p>Define eligible customers, dispatched messages, orders, refunds and reporting windows before launch. Attributed revenue is a reporting allocation; it is not automatically incremental revenue. Use comparable cohorts or a suitable randomized holdout where feasible, and report uncertainty. Count operational improvement, such as resolved wrong-variant links, separately from an unmeasured revenue claim.</p>
  </div></section>
  <section class="container pb-12"><div class="prose-shopify max-w-4xl">
    <h2>Demonstrate the hard case in the current stack</h2>
    <p>Ask the existing tool to execute the fixture, show missing fields and explain what an operator must maintain manually. Compare alternatives only on the demonstrated gap, including integration work, billing units, support and the cost of operating exceptions. Keep supplier claims scoped to current primary documentation and a relevant demonstration; this directory does not establish a default vendor winner.</p>
  </div></section>
  <section class="container pb-12"><div class="prose-shopify max-w-4xl">
    <h2>Plan a release around dependencies</h2>
    <p>Build and inspect controlled fixtures before enabling customer sends. Confirm which system owns each event and pause an incumbent equivalent before activating its replacement. Preserve suppression and offer state during a move, with a rollback owner and recorded checkpoint. Rehearsal and archive duration follow the workflow and recovery requirements, not fixed calendar seasons or universal migration windows.</p>
  </div></section>
  <section class="container pb-12"><div class="prose-shopify max-w-4xl">
    <h2>Review when the contract changes</h2>
    <p>Revisit the affected guide when catalog structure, subscriptions, fulfillment, markets, capture source or offer policy changes. Assign an owner to the shared dependency and update active consumers as well as the written runbook. Use store-type guides for catalog and buying-cycle context. The linked playbooks are planning resources; their presence here is not evidence that every vendor claim or merchant outcome has been independently tested.</p>
  </div></section>
  <nav class="container pb-12 flex flex-wrap gap-4" aria-label="Related guides"><a class="link" href="/for">Store-type guides</a><a class="link" href="/guides/selection-framework">Selection framework</a><a class="link" href="/guides/implementation-plan">Implementation planning</a></nav>
  <FaqSection faqs={faqs} title="Use-case hub FAQ" />
</BaseLayout>
