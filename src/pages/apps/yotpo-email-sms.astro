---
import BaseLayout from '../../layouts/BaseLayout.astro';
import ArticleSchema from '../../components/ArticleSchema.astro';
import FaqSection from '../../components/FaqSection.astro';
import { site, description, pageTitle } from '../../content';
import { appBySlug } from '../../data/apps';

const app = appBySlug('yotpo-email-sms')!;
const path = '/apps/yotpo-email-sms';
const title = pageTitle(site, 'apps/yotpo-email-sms');
const desc = description(site, 'apps/yotpo-email-sms');

const faqs = [
  {
    "question": "Is Yotpo Email & SMS an option for a new Shopify store?",
    "answer": "No. Yotpo announced full Email and SMS deprecation for December 31, 2025. Assess a supported sender for new messaging. Reviews and Loyalty are separate product decisions; using either does not make retired messaging available."
  },
  {
    "question": "How should I evaluate old Yotpo messaging charges?",
    "answer": "Reconcile invoices and contract line items for retired messaging separately from active Reviews or Loyalty subscriptions. Ask the provider about unresolved charges and accessible records. Historical bundle prices are not current offers and do not support savings claims."
  },
  {
    "question": "Can Yotpo Email replace Klaviyo now?",
    "answer": "Do not migrate into the retired sender. Inventory the journeys you need and demonstrate their data and suppression behavior in a supported replacement. Existing Reviews or Loyalty usage can be retained while messaging is evaluated separately."
  },
  {
    "question": "What happens to review-request timing?",
    "answer": "Identify which active product owns each request and which event starts it. Verify fulfillment versus delivery, duplicate prevention and the available destination integration with staff orders. Do not infer current review-request behavior from the retired Email and SMS suite."
  },
  {
    "question": "Yotpo SMS or Postscript for Shopify?",
    "answer": "Retired Yotpo SMS is not a current purchase alternative. For a supported SMS sender, demonstrate your required markets, number setup, consent transfer, opt-out processing and queue ownership. A historical comparison is not current channel availability."
  },
  {
    "question": "Should I consolidate messaging with Yotpo Reviews and Loyalty?",
    "answer": "The old all-in-one messaging consolidation proposal is no longer available. Evaluate active Reviews and Loyalty on their own jobs, and confirm how the chosen sender receives required fields. Count integration maintenance and data freshness in total operating cost."
  },
  {
    "question": "How long does an exit take?",
    "answer": "Use actual record access, destination validation and journey dependencies to set the schedule. Since deprecation has passed, do not assume the old dashboard or exports remain accessible. Seek missing records from the provider and retained business systems before promising a cutover date."
  },
  {
    "question": "Can I reuse UGC in replacement campaigns?",
    "answer": "Inventory accessible assets and permission records. Confirm the right to use each asset, attribution requirements, destination rendering and product mapping. Review collection alone does not establish permission to reuse a photo in marketing."
  },
  {
    "question": "Should I choose Yotpo over Sequenzy?",
    "answer": "For new email and SMS, evaluate a supported messaging provider rather than retired Yotpo messaging. A separate decision can retain Yotpo Reviews or Loyalty if it meets your needs. Demonstrate the required integration instead of assuming one dashboard is necessary."
  }
];
---

<BaseLayout title={title} description={desc} site={site} path={path}>
  <ArticleSchema title={title} description={desc} siteName={site.name} domain={site.domain} path={path} />
  <section class="container py-16">
    <a class="link" href="/apps">← All app reviews</a>
    <p class="editorial-kicker mt-6">Supplier scope checked November 25, 2026</p>
    <h1 class="hero-title mt-5">{app.name} for Shopify stores</h1>
    <p class="mt-7 max-w-3xl text-xl leading-9">Yotpo Email &amp; SMS is a retired messaging product. A Shopify merchant arriving here needs an exit inventory, a replacement sender decision and continuity for any separate Reviews or Loyalty program. Buying more Yotpo modules cannot restore the retired sender. This page supplies proposed recovery and migration exercises, not merchant test results or a current messaging quote.</p>
  </section>
  <section class="container pb-12">
    <div class="prose-shopify mb-12">
      <h2 class="font-serif text-4xl font-black">Retirement boundary and current sources</h2>
      <p>The <a href="https://www.yotpo.com/blog/email-sms-migration-partners/">official migration announcement</a>, updated September 15, 2025, scheduled full Email and SMS deprecation for December 31, 2025. Its recommended partners were Attentive and Omnisend. That recommendation is supplier guidance, not this site independently scoring either provider or confirming your account access.</p>
      <p>The announcement discusses Reviews and Loyalty integration separately. It does not justify treating those products as retired along with messaging. Inspect their current product documentation and your agreement for the features you use. A legacy review page, historical rank or module bundle cannot establish a current email purchase option.</p>
      <p>Check the <a href="https://email-and-sms.yotpo.com/">messaging service notice</a> and contact the provider for account-specific recovery questions. Do not promise an export simply because a historical help article describes one. At this date, recovery may depend on retained exports, Shopify records, destination records or support assistance.</p>
    </div>
    <div class="prose-shopify mb-12">
      <h2 class="font-serif text-4xl font-black">Exit inventory: what to recover first</h2>
      <p>Assign a person to each inventory: customer identifiers, channel permission records, unsubscribe and STOP history, bounce suppressions, templates, media rights, automation logic and billing documents. Record where each dataset is actually available and the latest timestamp. A contact address without its provenance is not a ready-to-send audience.</p>
      <p>Create a journey ledger listing trigger, eligible cohort, current owner, pending queue status and proposed destination. Include welcome, cart, order education, review requests and loyalty expiry reminders. Distinguish a disabled automation from canceled delayed sends. If the retired system cannot be inspected, mark queue status unknown and seek provider confirmation rather than claiming a live parallel run.</p>
      <p>Preserve external keys and event identifiers in any permitted transfer. Match guest and account purchases without collapsing different people who share a household phone number. Reconcile current purchases and suppressions immediately before activation; a historical export can already be stale.</p>
    </div>
    <div class="prose-shopify mb-12">
      <h2 class="font-serif text-4xl font-black">Reviews continuity is its own job</h2>
      <p>For an active Reviews program, identify the owner of collection requests and the system holding collected reviews. Confirm storefront display, moderation process, product identifiers and accessible assets independently of the messaging exit. Replacing an ESP is not a reason to remove a working review widget or duplicate collection requests.</p>
      <p>Use staff orders for a single shipment, a partial shipment, a cancellation and a delayed delivery. Determine which event the active request uses. If only fulfillment is available, do not label it delivery. Schedule review collection according to the product and actual availability of evidence, rather than reusing an unsupported universal day-seven rule.</p>
      <p>Collect reviews consistently across eligible customers. Do not withhold a request because a shopper returned an item, opened a complaint or might leave a low rating. Keep marketing cross-sell eligibility and review collection policy distinct; submission of a review is not proof of satisfaction or permission for a promotional send.</p>
    </div>
    <div class="prose-shopify mb-12">
      <h2 class="font-serif text-4xl font-black">Loyalty continuity: balances, expiry and redemption</h2>
      <p>Keep the loyalty system of record explicit. For each field the destination needs, document customer key, balance, tier, expiry date, update time and whether the value is a balance or redeemable reward. Confirm the integration on the actual plans; a partner announcement does not prove every field is available in your account.</p>
      <p>Proposed rehearsal: staff member earns points, redeems a reward, receives a refund and changes tier. Compare the account display to the email preview after each event. Hold the message or omit the balance if freshness cannot be established. A claim that a shopper has enough points for a free bag requires the actual redemption rule and eligible product, not just a numeric merge field.</p>
      <p>Expiry messaging must follow program terms and customer eligibility. Check changed expiry after redemption and purchases before release. Let the loyalty owner approve the content while the sender owner controls delivery; finance should reconcile points liability separately from campaign-attributed revenue.</p>
    </div>
    <div class="prose-shopify mb-12">
      <h2 class="font-serif text-4xl font-black">Replacement selection without a consolidation winner</h2>
      <p>Bring a concrete requirement set to a supported sender: purchase stop rules, variant content, permission transfer, review-request ownership, loyalty field freshness and SMS destinations. Demonstrate the important path using staff records. Count failed or unavailable dependencies explicitly rather than substituting a broad ecommerce integration badge.</p>
      <p>Yotpo named Attentive and Omnisend as migration partners in its notice. Include them where their present offering fits, while checking current integration access and service terms directly. Sequenzy or another sender may warrant evaluation for a different operating model; this page supplies no best-overall score or claim that one provider generates faster ROI.</p>
      <p>Keeping Reviews and Loyalty while changing messaging can preserve useful customer context. The value comes from working collection, redemption and data transfer, not a single-login promise. Compare the operator time needed to reconcile fields and correct a failed integration alongside license costs.</p>
    </div>
    <div class="prose-shopify mb-12">
      <h2 class="font-serif text-4xl font-black">Invoice reconciliation and replacement cost</h2>
      <p>Do not buy a historical Email/SMS bundle. Split the current invoice into active Reviews, active Loyalty, any other contracted service and disputed or legacy messaging lines. Confirm cancellation terms, credits and record access with the provider. No price range formerly printed here is a current quote.</p>
      <p>Build the replacement budget from the same contacts, send volumes, SMS markets, support needs and integration requirements for each candidate. Add one-time data cleanup and staff training, then recurring field reconciliation and template maintenance. Keep retained Reviews and Loyalty expenses in both scenarios when they do not change.</p>
      <p>Conditional arithmetic example: if two future written quotes differ by $200 per month, the annual license difference is $2,400. If transition work costs $3,000, license savings alone would take 15 months to recover it, assuming the difference persists. This is a planning calculation, not a Yotpo price, merchant saving or forecast revenue lift.</p>
    </div>
    <div class="prose-shopify mb-12">
      <h2 class="font-serif text-4xl font-black">Proposed welcome rehearsal: loyalty signup</h2>
      <p>Use a staff signup that can be linked to a loyalty account. Explain program terms from the active source and preview any enrollment bonus against actual eligibility. Test an existing member and a new member separately so the welcome draft does not promise a second first-purchase reward.</p>
      <p>Assign one welcome sender and check whether the loyalty product also sends enrollment messages. Submit an unsubscribe and a purchase between draft and release. Acceptance requires the promotional sequence to honor current eligibility and avoid duplicate promises. Observe purchase and enrollment behavior only after a real pilot; no former 12% or 34% outcome is evidence.</p>
    </div>
    <div class="prose-shopify mb-12">
      <h2 class="font-serif text-4xl font-black">Proposed cart rehearsal: VIP with a changing balance</h2>
      <p>Build an $89 protein cart on a staff VIP account. In the replacement sender, preview the cart, tier and any points statement. Then redeem points elsewhere, complete checkout and change phone permission before the next queued message. Each change should be reflected in eligibility or content before release.</p>
      <p>Confirm who owns email recovery and SMS recovery, including any existing Postscript program. A shared customer key does not itself cancel another provider’s queue. Record the exact stop mechanism and replay the purchase event once to check duplication. Do not use the retired Yotpo sender as one side of this exercise.</p>
    </div>
    <div class="prose-shopify mb-12">
      <h2 class="font-serif text-4xl font-black">Proposed post-purchase rehearsal: requests and education</h2>
      <p>Use an order containing two products with different delivery times. Keep care or usage education distinct from the review request. For the proposed replacement, demonstrate the event source, product-level request link and duplicate prevention before choosing a delay. A fixed day-seven review and day-fourteen cross-sell is only a possible pilot schedule.</p>
      <p>A complaint or return can require service follow-up before promotion, but should not be used to selectively solicit positive reviews. Avoid making cross-sell conditional on whether a review was submitted as a proxy for satisfaction. Measure service contacts, review coverage and subsequent purchase separately; no causal NPS or return-rate result is established here.</p>
    </div>
    <div class="prose-shopify mb-12">
      <h2 class="font-serif text-4xl font-black">Proposed winback rehearsal: expiring points</h2>
      <p>Use a staff account with 600 points and a documented expiry date, then change the expiry or redeem the balance before scheduling. Verify that the destination can refresh the relevant fields; if it cannot, use a link to the current account balance rather than asserting stale urgency in the message.</p>
      <p>Treat a 75-day lapse and 14-day expiry window as proposed cohort settings, not proven optimal timing. Suppress a new purchaser and honor each channel’s permission independently. Compare education and expiry messages only with eligible recipients and a clear measurement plan. No reactivation or redemption percentage on the former page is retained as a result.</p>
    </div>
    <div class="prose-shopify mb-12">
      <h2 class="font-serif text-4xl font-black">Skincare case: preserving context while changing the sender</h2>
      <p>Hypothetical brief: a skincare brand wants to keep an active Reviews program and use loyalty context in replacement winback messages. Start with its current product mappings, photo rights, points rules and audience permissions. The task is to transfer the needed context without recreating retired Yotpo messaging.</p>
      <p>Ask the replacement to render one real approved review asset and a current account link in a draft. Test a deleted product, missing photo and expired reward before accepting it. A fallback without the asset or balance must still read correctly. Do not claim that a named merchant obtained a conversion multiple, avoided a revenue dip or saved a fixed bundle amount; those claims were unsupported.</p>
      <p>For launch-week edits, rehearse a changed VIP cohort and unavailable SKU with the operator who will actually run the campaign. Choose an acceptance time based on that team’s operating needs. An arbitrary half-hour edit target does not establish a platform’s suitability.</p>
    </div>
    <div class="prose-shopify mb-12">
      <h2 class="font-serif text-4xl font-black">Cutover checkpoints and operating cadence</h2>
      <p>First checkpoint: establish record access and who owns each journey. Second: reconcile identities, channel permissions and suppressions in the destination. Third: rehearse changed purchases, redemptions and opt-outs during queue delays. Fourth: enable an exclusive pilot cohort only after its dependencies pass. These are acceptance stages, not a guaranteed 90-day schedule.</p>
      <p>At cutover, cancel or drain accessible old queues and confirm unresolved legacy status with the provider. Do not assume a deprecated dashboard is still operational or propose keeping Yotpo SMS active while moving email. Retained Reviews and Loyalty can continue only under their own verified setup and request ownership.</p>
      <p>During the pilot, inspect failed field updates and duplicate journey entries daily. Review permission and purchase freshness before campaigns; periodically reconcile invoice lines, integration ownership and loyalty terms. Record actual observations separately from supplier claims. Engagement metrics alone do not authorize a transfer or send.</p>
    </div>
    <div class="prose-shopify mb-12">
      <h2 class="font-serif text-4xl font-black">Failure rehearsal and handoff</h2>
      <p>If an export is unavailable, document what is missing and ask the provider about recovery; do not fabricate a complete consent history from Shopify purchases. If the loyalty balance is stale, hold the numeric claim and link to the account. If review requests duplicate, name a single owner and cancel the competing request where accessible.</p>
      <p>If UGC has no documented reuse rights, omit it until rights are established. If a replacement integration is unavailable on the selected plan, revise the workflow or quote before signing. Keep a handoff record with source system, customer key, field refresh, journey owner, queue state and rollback action so the next operator can resolve a failure.</p>
      <p>The linked comparison routes, including Marsello versus Yotpo, remain useful navigation into historical context and adjacent decisions. Their existence is not evidence that retired messaging can be purchased. Evaluate active Reviews, Loyalty and replacement messaging on their respective operational jobs.</p>
    </div>
    <div class="card mb-12"><h2 class="font-serif text-3xl font-black">Related decision guides and comparisons</h2>
      <ul class="mt-6 space-y-3">
        <li><a class="link" href="/apps">Apps</a></li>
        <li><a class="link" href="/compare/klaviyo-vs-yotpo-email-sms">Klaviyo Vs Yotpo Email Sms</a></li>
        <li><a class="link" href="/use-cases/reviews-and-ugc">Reviews And Ugc</a></li>
        <li><a class="link" href="/use-cases/loyalty">Loyalty</a></li>
        <li><a class="link" href="/compare/sequenzy-vs-yotpo-email-sms">Sequenzy Vs Yotpo Email Sms</a></li>
        <li><a class="link" href="/compare/omnisend-vs-yotpo-email-sms">Omnisend Vs Yotpo Email Sms</a></li>
        <li><a class="link" href="/compare/marsello-vs-yotpo-email-sms">Marsello Vs Yotpo Email Sms</a></li>
        <li><a class="link" href="/apps/sequenzy">Sequenzy</a></li>
      </ul>
    </div>
  </section>
  <FaqSection faqs={faqs} title="Yotpo Email &amp; SMS FAQ" />
</BaseLayout>
