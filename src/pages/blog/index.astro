---
import BaseLayout from '../../layouts/BaseLayout.astro';
const title = 'Shopify Email App Guides';
const description = 'Browse Shopify email app guides by store type, lifecycle job, campaign, and operating constraint.';
const faqs = [{"question": "Which guide should a brand-new store read first?", "answer": "Start with the store-model guide closest to your catalog, then the welcome-series guide to define the signup promise. Add cart recovery when that workflow is part of your launch plan."}, {"question": "How current is the pricing information?", "answer": "Use current supplier pricing and a quote for your own list, volume, and channels. Article examples and linked prices may not reflect your account or contract."}, {"question": "Do these guides replace a deliverability audit?", "answer": "No. Use them to frame tool requirements. An audit needs evidence from your sending domains, permission records, sending history, and delivery results."}, {"question": "How should I combine guides into a decision?", "answer": "Read a store-model guide for audience constraints, a lifecycle guide for the specific workflow, and the selection framework for comparing candidates. Ask finalists to demonstrate the same workflow and price the same workload."}, {"question": "What if my store model is not covered?", "answer": "Use the closest catalog and buying-cycle analogy, then list the differences. For example, a preorder store needs availability and cancellation rules that a standard in-stock welcome sequence may not address."}];
const guides = [
  ['Best Shopify Email Apps for Fashion Stores','/blog/best-shopify-email-apps-for-fashion-stores'],
  ['Best Shopify Email Apps for Abandoned Cart Recovery','/blog/best-shopify-email-apps-for-abandoned-cart-recovery'],
  ['Best Shopify Email Apps for BFCM','/blog/best-shopify-email-apps-for-bfcm'],
  ['Best Shopify Email Apps for Segmentation','/blog/best-shopify-email-apps-for-segmentation'],
  ['Best Shopify Email Apps for Deliverability','/blog/best-shopify-email-apps-for-deliverability'],
  ['Best Shopify Email Apps for Customer Retention','/blog/best-shopify-email-apps-for-customer-retention'],
  ['Best Shopify Email Apps for Product Recommendations','/blog/best-shopify-email-apps-for-product-recommendations'],
  ['Best Shopify Email Apps for New Collections','/blog/best-shopify-email-apps-for-new-collections'],
  ['Best Shopify Email Apps for Customer Stories','/blog/best-shopify-email-apps-for-customer-stories'],
  ['Best Shopify Email Apps for List Hygiene','/blog/best-shopify-email-apps-for-list-hygiene'],
];
---
